# Copy to .env locally and set a token there. Never commit .env or token values.
# Copilot CLI checks these in precedence order:
# COPILOT_GITHUB_TOKEN, GH_TOKEN, GITHUB_TOKEN
COPILOT_GITHUB_TOKEN=
GITHUB_COPILOT_MODEL=gpt-5
GITHUB_COPILOT_TIMEOUT=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
